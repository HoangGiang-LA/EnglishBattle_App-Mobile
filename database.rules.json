{
  "rules": {
    ".read": false,
    ".write": false,
    "adminOperations": {".indexOn": ["dueAt", "cleanupAt"]},
    "adminRoleOperations": {".indexOn": ["dueAt", "cleanupAt"]},
    "adminAudit": {".indexOn": ["at", "expiresAt"]},
    "adminRateLimits": {".indexOn": ["expiresAt"]},
    "adminSnapshots": {".indexOn": ["expiresAt"]},
    "adminReports": {".indexOn": ["expiresAt"]},
    "adminAnalyticsGenerationMeta": {".indexOn": ["expiresAt"]},
    "adminAnalyticsGenerations": {"$generation": {"events": {"$skill": {".indexOn": ["at"]}}}},
    "adminUserIndex": {".indexOn": ["nameKey", "emailKey", "createdAt", "updatedAt", "status"]},
    "adminInvitations": {".indexOn": ["dueAt", "cleanupAt"]},
    "adminQuestionIndex": {".indexOn": ["searchKey", "updatedAt", "status", "categoryId", "lessonId"]},
    "adminBattleIndex": {".indexOn": ["startedAt", "status", "mode", "categoryId"]},
    "adminActivityIndex": {".indexOn": ["at", "type", "categoryId"]},
    "adminNotifications": {"$uid": {".indexOn": ["at", "read"]}},
    "adminNotificationEvents": {".indexOn": ["at", "publishedAt", "expiresAt"]},
    "communityCursors": {".indexOn": ["expiresAt"]},
    "communityRankings": {".indexOn": ["expiresAt"]},
    "learningWork": {
      ".indexOn": ["dueAt"]
    },
    "battleWork": {
      ".indexOn": ["dueAt"]
    },
    "battleHistory": {
      "$uid": {
        ".indexOn": ["finishedAt"]
      }
    },
    "categories": {
      ".indexOn": ["status"],
      ".read": "auth != null && root.child('accountAccess').child(auth.uid).child('status').val() === 'active' && query.orderByChild === 'status' && query.equalTo === 'published'"
    },
    "topics": {
      ".indexOn": ["status", "categoryId"],
      ".read": "auth != null && root.child('accountAccess').child(auth.uid).child('status').val() === 'active' && query.orderByChild === 'status' && query.equalTo === 'published'"
    },
    "questions": {".indexOn": ["topicId", "lessonId", "status", "updatedAt"]},
    "accountAccess": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "practiceAttempts": {
      "$uid": {
        ".indexOn": ["finishedAt", "status"]
      }
    },
    "notifications": {
      "$uid": {
        ".indexOn": ["createdAt"]
      }
    },
    "coinLedger": {
      "$uid": {
        ".indexOn": ["createdAt"]
      }
    }
  }
}
